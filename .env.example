# Service account from Common Services > Identity & Access (the TSG with AIOps for NGFW / SCM)
PAN_CLIENT_ID=name@1234567890.iam.panserviceaccount.com
PAN_CLIENT_SECRET=xxxxxxxx
PAN_TSG_ID=1234567890

# Optional
# BPA_MOCK=1              # try the tool without real API calls
# BPA_UPLOAD_GZIP=1       # actually gzip the config before upload (only if the default fails)
# BPA_KEEP_CONFIG=1       # keep a local copy of the config (deleted after upload by default)
# PAN_API_BASE=https://api.strata.paloaltonetworks.com/posture/checks/v1
