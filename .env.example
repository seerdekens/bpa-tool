# Service account uit Common Services > Identity & Access (TSG met AIOps for NGFW / SCM)
PAN_CLIENT_ID=naam@1234567890.iam.panserviceaccount.com
PAN_CLIENT_SECRET=xxxxxxxx
PAN_TSG_ID=1234567890

# Optioneel
# BPA_MOCK=1              # test zonder echte API-calls
# BPA_UPLOAD_GZIP=1       # config echt gzippen voor upload (enkel als de standaard faalt)
# BPA_KEEP_CONFIG=1       # lokale kopie van de config bewaren (standaard verwijderd na upload)
# PAN_API_BASE=https://api.strata.paloaltonetworks.com/posture/checks/v1
